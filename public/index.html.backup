<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OCEAN EYE - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Share+Tech+Mono&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="manifest" href="/manifest.json">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family:'Rajdhani',sans-serif;
            background:#05080f;
            color:#e8edf5;
            min-height:100vh;
            overflow:hidden;
            display:flex;
        }
        .space-bg {
            position:fixed;
            top:0;left:0;width:100%;height:100%;
            background:radial-gradient(ellipse at 20% 30%, rgba(10,40,100,0.15) 0%, transparent 60%), radial-gradient(ellipse at 70% 60%, rgba(0,200,150,0.04) 0%, transparent 50%), radial-gradient(ellipse at 50% 100%, rgba(100,50,200,0.04) 0%, transparent 40%);
            pointer-events:none; z-index:0;
        }
        .space-bg .stars {
            position:absolute; top:0; left:0; width:100%; height:100%;
            background-image:radial-gradient(1px 1px at 5% 10%, #fff, transparent), radial-gradient(1px 1px at 15% 25%, #fff, transparent), radial-gradient(1px 1px at 25% 40%, #fff, transparent), radial-gradient(1px 1px at 35% 55%, #fff, transparent), radial-gradient(1px 1px at 45% 70%, #fff, transparent), radial-gradient(1px 1px at 55% 85%, #fff, transparent), radial-gradient(1px 1px at 65% 15%, #fff, transparent), radial-gradient(1px 1px at 75% 30%, #fff, transparent), radial-gradient(1px 1px at 85% 45%, #fff, transparent), radial-gradient(1px 1px at 95% 60%, #fff, transparent);
            background-size:100% 100%; background-repeat:no-repeat; animation:twinkle 4s infinite alternate;
        }
        @keyframes twinkle { 0%{opacity:0.2;} 100%{opacity:0.8;} }
        ::-webkit-scrollbar { width:3px; }
        ::-webkit-scrollbar-track { background:#05080f; }
        ::-webkit-scrollbar-thumb { background:linear-gradient(180deg,#4a9eff,#00d4aa); border-radius:10px; }

        .sidebar {
            width:240px; min-width:240px; height:100vh;
            background:rgba(5,8,15,0.95); backdrop-filter:blur(30px);
            border-right:1px solid rgba(74,158,255,0.05);
            display:flex; flex-direction:column; position:fixed; left:0; top:0; z-index:100;
            padding:10px 0; overflow-y:auto;
        }
        .sidebar .logo { padding:10px 20px 16px; border-bottom:1px solid rgba(74,158,255,0.05); }
        .sidebar .logo .icon { font-size:24px; display:block; margin-bottom:2px; }
        .sidebar .logo h1 { font-family:'Orbitron',monospace; font-size:16px; font-weight:700; background:linear-gradient(135deg,#4a9eff,#00d4aa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; letter-spacing:1px; }
        .sidebar .logo .badge { font-family:'Share Tech Mono',monospace; font-size:7px; color:#00d4aa; border:1px solid rgba(0,212,170,0.08); padding:1px 8px; border-radius:20px; letter-spacing:1px; background:rgba(0,212,170,0.02); }
        .sidebar .logo .badge .dot { display:inline-block; width:4px; height:4px; background:#00d4aa; border-radius:50%; animation:pulse-dot 1.5s infinite; margin-right:3px; }
        @keyframes pulse-dot { 0%,100%{opacity:1;} 50%{opacity:0.2;} }
        .sidebar .nav-items { flex:1; padding:8px 0; }
        .sidebar .nav-item {
            display:flex; align-items:center; gap:12px;
            padding:10px 20px; margin:2px 8px; border-radius:6px;
            cursor:pointer; transition:all 0.3s ease;
            font-family:'Rajdhani',sans-serif; font-size:14px; font-weight:500;
            color:#64748b; position:relative;
        }
        .sidebar .nav-item:hover { background:rgba(255,255,255,0.03); color:#e2e8f0; }
        .sidebar .nav-item.active { background:linear-gradient(135deg,rgba(74,158,255,0.08),rgba(0,212,170,0.04)); color:#e2e8f0; border:1px solid rgba(74,158,255,0.05); }
        .sidebar .nav-item .icon { font-size:16px; width:24px; text-align:center; }
        .sidebar .nav-item .indicator { position:absolute; right:0; top:50%; transform:translateY(-50%); width:3px; height:20px; border-radius:2px; background:linear-gradient(180deg,#4a9eff,#00d4aa); opacity:0; transition:all 0.3s; }
        .sidebar .nav-item.active .indicator { opacity:1; }
        .sidebar .nav-item .badge-count {
            position:absolute; right:20px; top:50%; transform:translateY(-50%);
            background:#ef4444; color:#fff; font-size:8px; font-weight:700;
            padding:1px 6px; border-radius:10px; font-family:'Share Tech Mono',monospace;
        }
        .sidebar .user-section {
            padding:12px 20px;
            border-top:1px solid rgba(255,255,255,0.02);
            display:flex;
            align-items:center;
            gap:10px;
            flex-wrap:wrap;
        }
        .sidebar .user-section img {
            width:32px; height:32px;
            border-radius:50%;
            border:1px solid rgba(74,158,255,0.1);
            object-fit:cover;
        }
        .sidebar .user-section .user-info { flex:1; min-width:60px; }
        .sidebar .user-section .user-info .name { font-size:12px; color:#e2e8f0; font-weight:500; }
        .sidebar .user-section .user-info .role { font-size:8px; color:#64748b; font-family:'Share Tech Mono',monospace; }
        .btn-logout-sm {
            background:rgba(239,68,68,0.04);
            color:#f87171;
            border:1px solid rgba(239,68,68,0.04);
            padding:3px 12px;
            border-radius:4px;
            font-size:9px;
            font-weight:600;
            cursor:pointer;
            transition:all 0.3s;
            font-family:'Rajdhani',sans-serif;
        }
        .btn-logout-sm:hover { background:rgba(239,68,68,0.08); }

        .main-content { margin-left:240px; flex:1; height:100vh; overflow-y:auto; padding:0; position:relative; z-index:1; }
        .page { display:none; padding:20px 30px 30px; animation:fadePage 0.4s ease; }
        .page.active { display:block; }
        @keyframes fadePage { 0% { opacity:0; transform:translateY(10px); } 100% { opacity:1; transform:translateY(0); } }
        .page-header { margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,0.02); }
        .page-header h2 { font-family:'Orbitron',monospace; font-size:20px; font-weight:700; letter-spacing:0.5px; display:flex; align-items:center; gap:10px; }
        .page-header h2 .highlight { background:linear-gradient(135deg,#4a9eff,#00d4aa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .page-header p { color:#64748b; font-size:13px; margin-top:3px; font-family:'Share Tech Mono',monospace; letter-spacing:0.2px; }
        .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:12px; }
        .grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:12px; }
        .grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:12px; }
        .grid-5 { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-top:12px; }
        .card { background:rgba(255,255,255,0.015); border:1px solid rgba(255,255,255,0.02); border-radius:8px; padding:16px 20px; transition:all 0.3s ease; backdrop-filter:blur(5px); }
        .card:hover { border-color:rgba(74,158,255,0.04); transform:translateY(-2px); box-shadow:0 4px 20px rgba(0,0,0,0.2); }
        .card-title { font-family:'Share Tech Mono',monospace; font-size:8px; font-weight:600; text-transform:uppercase; letter-spacing:0.8px; color:#64748b; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
        .card-title i { font-size:10px; color:#4a9eff; }
        .stat-number { font-family:'Orbitron',monospace; font-size:26px; font-weight:700; background:linear-gradient(135deg,#4a9eff,#00d4aa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .stat-number.danger { background:linear-gradient(135deg,#ef4444,#dc2626); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .stat-number.warning { background:linear-gradient(135deg,#f59e0b,#d97706); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .stat-number.success { background:linear-gradient(135deg,#00d4aa,#059669); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .stat-label { font-size:9px; color:#94a3b8; font-family:'Share Tech Mono',monospace; margin-top:2px; }
        
        .btn { padding:6px 18px; border:none; border-radius:5px; font-size:11px; font-weight:600; cursor:pointer; transition:all 0.3s ease; display:inline-flex; align-items:center; gap:6px; font-family:'Rajdhani',sans-serif; }
        .btn-primary { background:linear-gradient(135deg,#4a9eff,#7c3aed); color:#fff; box-shadow:0 2px 10px rgba(74,158,255,0.1); }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 4px 20px rgba(74,158,255,0.2); }
        .btn-danger { background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; box-shadow:0 2px 10px rgba(239,68,68,0.1); }
        .btn-danger:hover { transform:translateY(-2px); box-shadow:0 4px 20px rgba(239,68,68,0.2); }
        .btn-success { background:linear-gradient(135deg,#00d4aa,#059669); color:#fff; box-shadow:0 2px 10px rgba(0,212,170,0.1); }
        .btn-success:hover { transform:translateY(-2px); box-shadow:0 4px 20px rgba(0,212,170,0.2); }
        .btn-warning { background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; box-shadow:0 2px 10px rgba(245,158,11,0.1); }
        .btn-warning:hover { transform:translateY(-2px); box-shadow:0 4px 20px rgba(245,158,11,0.2); }
        .btn-outline { background:transparent; color:#94a3b8; border:1px solid rgba(255,255,255,0.04); }
        .btn-outline:hover { background:rgba(255,255,255,0.02); border-color:rgba(255,255,255,0.08); transform:translateY(-2px); color:#e2e8f0; }
        .btn-sm { padding:3px 10px; font-size:9px; border-radius:3px; }
        .btn-group { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }

        .map-wrapper { background:rgba(255,255,255,0.01); border:1px solid rgba(255,255,255,0.01); border-radius:8px; overflow:hidden; height:400px; position:relative; }
        #map { width:100%; height:100%; }
        .map-legend { position:absolute; bottom:8px; left:8px; z-index:10; background:rgba(5,8,15,0.9); backdrop-filter:blur(8px); padding:4px 10px; border-radius:4px; border:1px solid rgba(255,255,255,0.01); display:flex; gap:8px; flex-wrap:wrap; font-size:7px; color:#64748b; font-family:'Share Tech Mono',monospace; }
        .map-legend .color { display:inline-block; width:10px; height:10px; border-radius:2px; }
        .map-legend .color.green { background:#00d4aa; }
        .map-legend .color.yellow { background:#fbbf24; }
        .map-legend .color.blue { background:#4a9eff; }
        .map-legend .color.red { background:#ef4444; }

        .role-badge {
            display:inline-block; padding:1px 10px; border-radius:12px;
            font-size:7px; font-weight:700; text-transform:uppercase;
            font-family:'Share Tech Mono',monospace; letter-spacing:0.5px;
        }
        .role-badge.admin { background:rgba(74,158,255,0.15); color:#4a9eff; border:1px solid rgba(74,158,255,0.1); }
        .role-badge.isro { background:rgba(167,139,250,0.15); color:#a78bfa; border:1px solid rgba(167,139,250,0.1); }
        .role-badge.coastguard { background:rgba(239,68,68,0.15); color:#f87171; border:1px solid rgba(239,68,68,0.1); }
        .role-badge.dgship { background:rgba(245,158,11,0.15); color:#fbbf24; border:1px solid rgba(245,158,11,0.1); }
        .role-badge.operator { background:rgba(0,212,170,0.15); color:#00d4aa; border:1px solid rgba(0,212,170,0.1); }

        .scenario-selector { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:10px; }
        .scenario-card { background:rgba(255,255,255,0.01); border:1px solid rgba(255,255,255,0.01); border-radius:6px; padding:10px 12px; transition:all 0.3s ease; cursor:pointer; text-align:center; }
        .scenario-card:hover { border-color:rgba(74,158,255,0.04); transform:translateY(-2px); box-shadow:0 4px 15px rgba(0,0,0,0.1); }
        .scenario-card .icon { font-size:24px; display:block; margin-bottom:2px; }
        .scenario-card .title { font-size:12px; font-weight:600; font-family:'Orbitron',monospace; letter-spacing:0.2px; }
        .scenario-card .desc { font-size:8px; color:#94a3b8; margin-top:2px; line-height:1.3; }
        .scenario-card .badge { display:inline-block; padding:1px 6px; border-radius:100px; font-size:5px; font-weight:700; text-transform:uppercase; margin-top:3px; font-family:'Share Tech Mono',monospace; }
        .scenario-card.culprit .title { color:#f87171; }
        .scenario-card.culprit .badge { color:#f87171; background:rgba(239,68,68,0.04); border:1px solid rgba(239,68,68,0.04); }
        .scenario-card.culprit.active { border-color:#ef4444; background:rgba(239,68,68,0.015); }
        .scenario-card.natural .title { color:#4a9eff; }
        .scenario-card.natural .badge { color:#4a9eff; background:rgba(74,158,255,0.04); border:1px solid rgba(74,158,255,0.04); }
        .scenario-card.natural.active { border-color:#4a9eff; background:rgba(74,158,255,0.015); }
        .scenario-card.internal .title { color:#f97316; }
        .scenario-card.internal .badge { color:#f97316; background:rgba(249,115,22,0.04); border:1px solid rgba(249,115,22,0.04); }
        .scenario-card.internal.active { border-color:#f97316; background:rgba(249,115,22,0.015); }
        .scenario-card.collision .title { color:#a78bfa; }
        .scenario-card.collision .badge { color:#a78bfa; background:rgba(167,139,250,0.04); border:1px solid rgba(167,139,250,0.04); }
        .scenario-card.collision.active { border-color:#a78bfa; background:rgba(167,139,250,0.015); }
        .scenario-card.fire .title { color:#ef4444; }
        .scenario-card.fire .badge { color:#ef4444; background:rgba(239,68,68,0.04); border:1px solid rgba(239,68,68,0.04); }
        .scenario-card.fire.active { border-color:#ef4444; background:rgba(239,68,68,0.015); }
        .scenario-card.weather .title { color:#60a5fa; }
        .scenario-card.weather .badge { color:#60a5fa; background:rgba(96,165,250,0.04); border:1px solid rgba(96,165,250,0.04); }
        .scenario-card.weather.active { border-color:#60a5fa; background:rgba(96,165,250,0.015); }

        .satellite-scanner { background:rgba(255,255,255,0.01); border:1px solid rgba(255,255,255,0.02); border-radius:8px; padding:16px 20px; position:relative; overflow:hidden; }
        .satellite-scanner .scan-overlay { position:absolute; top:0;left:0;width:100%;height:100%; background:linear-gradient(0deg,rgba(0,212,170,0.02) 0%,transparent 50%,rgba(0,212,170,0.02) 100%); animation:scanPulse 4s infinite; pointer-events:none; }
        @keyframes scanPulse { 0%,100%{opacity:0.2;} 50%{opacity:0.5;} }
        .satellite-scanner .sat-img { width:100%;height:130px; background:radial-gradient(ellipse at center,#0a1628,#020408); border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:38px; border:1px solid rgba(255,255,255,0.02); position:relative; overflow:hidden; }
        .satellite-scanner .sat-img .scan-line { position:absolute; top:0;left:0;width:100%;height:1px; background:linear-gradient(90deg,transparent,#4a9eff,transparent); animation:scanMove 2.5s infinite; display:none; }
        .satellite-scanner .sat-img .scan-line.active { display:block; }
        @keyframes scanMove { 0%{top:0;} 100%{top:100%;} }
        .satellite-scanner .sat-img .label { position:absolute; bottom:6px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.8); padding:2px 14px; border-radius:100px; font-size:8px; color:#94a3b8; white-space:nowrap; font-family:'Share Tech Mono',monospace; }
        .satellite-scanner .scan-stats { display:flex; justify-content:space-between; margin-top:8px; font-size:8px; color:#64748b; font-family:'Share Tech Mono',monospace; }
        .analysis-result { display:flex; justify-content:center; gap:14px; font-size:9px; margin-top:8px; flex-wrap:wrap; }
        .analysis-result .item { display:flex; align-items:center; gap:4px; color:#94a3b8; }

        .raw-data { background:rgba(0,0,0,0.3); border:1px solid rgba(74,158,255,0.05); border-radius:4px; padding:8px 12px; font-family:'Share Tech Mono',monospace; font-size:8px; color:#64748b; max-height:120px; overflow-y:auto; margin-top:8px; }
        .raw-data .data-line { padding:1px 0; border-bottom:1px solid rgba(255,255,255,0.02); display:flex; gap:10px; }
        .raw-data .data-line .key { color:#4a9eff; min-width:80px; }
        .raw-data .data-line .value { color:#94a3b8; }
        .raw-data .data-line .value.success { color:#00d4aa; }
        .raw-data .data-line .value.error { color:#f87171; }
        .raw-data .data-line .value.warning { color:#fbbf24; }
        .raw-data::-webkit-scrollbar { width:2px; }
        .raw-data::-webkit-scrollbar-track { background:transparent; }
        .raw-data::-webkit-scrollbar-thumb { background:rgba(74,158,255,0.2); border-radius:10px; }

        .alert-popup { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:2000; background:rgba(5,8,15,0.96); backdrop-filter:blur(30px); padding:24px 34px; border-radius:12px; border:1px solid rgba(74,158,255,0.03); box-shadow:0 20px 60px rgba(0,0,0,0.9); display:none; text-align:center; animation:slideDown 0.4s ease; max-width:92%; width:500px; }
        .alert-popup.show { display:block; }
        @keyframes slideDown { 0% { opacity:0; transform:translate(-50%,-40%) scale(0.96); } 100% { opacity:1; transform:translate(-50%,-50%) scale(1); } }
        .alert-popup .robot { font-size:50px; display:block; margin-bottom:6px; animation:float 3s ease-in-out infinite; }
        @keyframes float { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }
        .alert-popup .title { font-size:18px; font-weight:700; font-family:'Orbitron',monospace; }
        .alert-popup .sub { font-size:11px; opacity:0.6; margin-top:3px; }
        .alert-popup .details { font-size:11px; background:rgba(0,0,0,0.08); padding:5px 14px; border-radius:4px; margin-top:8px; display:inline-block; }
        .alert-popup .voice-indicator { display:flex; align-items:center; justify-content:center; gap:8px; padding:5px 12px; background:rgba(0,212,170,0.03); border-radius:4px; margin-top:10px; }
        .alert-popup .voice-indicator .speaker { font-size:16px; animation:speakPulse 0.8s infinite alternate; }
        @keyframes speakPulse { 0%{transform:scale(1);} 100%{transform:scale(1.06);} }
        .alert-popup .voice-indicator .label { font-size:10px; color:#00d4aa; font-family:'Share Tech Mono',monospace; }
        .alert-popup .sound-indicator { display:flex; align-items:center; justify-content:center; gap:8px; padding:5px 12px; background:rgba(239,68,68,0.03); border-radius:4px; margin-top:5px; }
        .alert-popup .sound-indicator .label { font-size:10px; color:#f87171; font-family:'Share Tech Mono',monospace; }
        .btn-stop { background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; padding:6px 24px; border:none; border-radius:5px; font-size:12px; font-weight:700; cursor:pointer; transition:all 0.3s; margin-top:8px; box-shadow:0 2px 15px rgba(245,158,11,0.1); }
        .btn-stop:hover { transform:scale(1.04) translateY(-2px); box-shadow:0 4px 25px rgba(245,158,11,0.2); }

        .language-selector { display:flex; gap:4px; flex-wrap:wrap; }
        .lang-btn { background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.03); color:#64748b; padding:2px 10px; border-radius:3px; font-size:8px; cursor:pointer; transition:all 0.3s; font-family:'Share Tech Mono',monospace; }
        .lang-btn:hover { background:rgba(255,255,255,0.04); color:#e2e8f0; }
        .lang-btn.active { background:rgba(74,158,255,0.04); border-color:rgba(74,158,255,0.05); color:#4a9eff; }

        .mission-log { max-height:100px; overflow-y:auto; font-family:'Share Tech Mono',monospace; font-size:8px; color:#64748b; padding:5px 8px; background:rgba(0,0,0,0.15); border-radius:4px; border:1px solid rgba(255,255,255,0.01); margin-top:8px; }
        .mission-log .log-entry { padding:2px 0; border-bottom:1px solid rgba(255,255,255,0.02); display:flex; gap:8px; }
        .mission-log .log-entry .time { color:#4a9eff; min-width:50px; }
        .mission-log .log-entry .msg { color:#94a3b8; }
        .mission-log .log-entry .msg.success { color:#00d4aa; }
        .mission-log .log-entry .msg.error { color:#f87171; }
        .mission-log::-webkit-scrollbar { width:2px; }
        .mission-log::-webkit-scrollbar-track { background:transparent; }
        .mission-log::-webkit-scrollbar-thumb { background:rgba(74,158,255,0.2); border-radius:10px; }

        /* Review Queue */
        .review-item { display:flex; align-items:center; gap:12px; padding:10px; background:rgba(255,255,255,0.01); border-radius:6px; border:1px solid rgba(255,255,255,0.02); margin-bottom:8px; }
        .review-item .preview { width:60px; height:60px; background:rgba(0,0,0,0.3); border-radius:4px; display:flex; align-items:center; justify-content:center; font-size:24px; }
        .review-item .info { flex:1; }
        .review-item .info .title { font-size:12px; font-weight:600; }
        .review-item .info .sub { font-size:9px; color:#94a3b8; }
        .review-item .actions { display:flex; gap:6px; }

        /* Priority Zones */
        .risk-heatmap { position:relative; width:100%; height:200px; background:radial-gradient(ellipse at 30% 40%, rgba(239,68,68,0.3) 0%, rgba(245,158,11,0.15) 30%, rgba(74,158,255,0.05) 70%, transparent 100%); border-radius:8px; border:1px solid rgba(255,255,255,0.02); display:flex; align-items:center; justify-content:center; }
        .risk-heatmap .label { font-size:10px; color:#94a3b8; font-family:'Share Tech Mono',monospace; }

        /* SMS Toggle */
        .sms-config { display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:8px 0; }
        .sms-config input[type="text"] { background:var(--bg); color:var(--text); padding:6px 12px; border:1px solid rgba(255,255,255,0.05); border-radius:4px; font-size:11px; font-family:'Share Tech Mono',monospace; width:180px; }

        @media (max-width:768px) {
            .sidebar { width:60px; min-width:60px; }
            .sidebar .logo h1, .sidebar .logo .badge, .sidebar .nav-item .label, .sidebar .user-section .user-info { display:none; }
            .sidebar .nav-item { padding:10px 12px; justify-content:center; }
            .sidebar .nav-item .icon { font-size:18px; width:auto; }
            .main-content { margin-left:60px; }
            .page { padding:12px 14px 20px; }
            .grid-2, .grid-3, .grid-4, .grid-5 { grid-template-columns:1fr; }
            .scenario-selector { grid-template-columns:1fr; }
            .map-wrapper { height:250px; }
            .satellite-scanner .sat-img { height:80px; font-size:24px; }
            .alert-popup { padding:16px 20px; width:95%; }
            .alert-popup .title { font-size:15px; }
            .raw-data { max-height:80px; font-size:7px; }
        }

        /* Toast Container */
        .toast-container { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; max-width:350px; }
        .toast { background:rgba(5,8,15,0.95); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,0.03); border-radius:8px; padding:10px 14px; color:#e8edf5; font-size:12px; animation:slideIn 0.4s ease; box-shadow:0 10px 40px rgba(0,0,0,0.5); }
        .toast .close-toast { background:transparent; border:none; color:#64748b; cursor:pointer; font-size:14px; padding:0 4px; }
        .toast.success { border-left:3px solid #00d4aa; }
        .toast.error { border-left:3px solid #ef4444; }
        .toast.warning { border-left:3px solid #f59e0b; }
        .toast.info { border-left:3px solid #4a9eff; }
        @keyframes slideIn { 0%{opacity:0;transform:translateX(20px);} 100%{opacity:1;transform:translateX(0);} }
    </style>
<!-- Leaflet Plugins -->
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet-fullscreen@1.0.2/dist/leaflet.fullscreen.css" />
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet-fullscreen@1.0.2/dist/Leaflet.fullscreen.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-heat/0.2.0/leaflet-heat.js"></script>
</head>
<body>
<div class="space-bg"><div class="stars"></div></div>

<div class="sidebar" id="sidebar">
    <div class="logo">
        <span class="icon">🛰️</span>
        <h1 id="appTitle">OCEAN EYE</h1>
        <span class="badge"><span class="dot"></span> <span id="appStatus">ACTIVE</span></span>
    </div>
    <div class="nav-items" id="navItems">
        <div class="nav-item active" onclick="showPage('page1')" data-role="all">
            <span class="icon">📊</span>
            <span class="label" id="navDashboard">Dashboard</span>
            <span class="indicator"></span>
        </div>
        <div class="nav-item" onclick="showPage('page7')" data-role="all">
            <span class="icon">📷</span>
            <span class="label" id="navImage">Image Analysis</span>
            <span class="indicator"></span>
        </div>
        <div class="nav-item" onclick="showPage('page2')" data-role="all">
            <span class="icon">🗺️</span>
            <span class="label" id="navMap">Map</span>
            <span class="indicator"></span>
        </div>
        <div class="nav-item" onclick="showPage('page3')" data-role="all">
            <span class="icon">🛰️</span>
            <span class="label" id="navSatellite">Satellite</span>
            <span class="indicator"></span>
        </div>
        <div class="nav-item" onclick="showPage('page4')" data-role="all">
            <span class="icon">🤖</span>
            <span class="label" id="navAlert">Alert</span>
            <span class="indicator"></span>
            <span class="badge-count" id="alertBadge" style="display:none;">0</span>
        </div>
        <div class="nav-item" onclick="showPage('page5')" data-role="all">
            <span class="icon">📈</span>
            <span class="label" id="navAnalysis">Analysis</span>
            <span class="indicator"></span>
        </div>
        <div class="nav-item" onclick="showPage('page8')" data-role="admin,coastguard">
            <span class="icon">🧠</span>
            <span class="label" id="navReview">Review Queue</span>
            <span class="indicator"></span>
            <span class="badge-count" id="reviewBadge" style="display:none;">0</span>
        </div>
        <div class="nav-item" onclick="showPage('page6')" data-role="all">
            <span class="icon">⚙️</span>
            <span class="label" id="navSettings">Settings</span>
            <span class="indicator"></span>
        </div>
    </div>

    <div class="user-section">
        <img id="userAvatar" src="" alt="User" style="display:none;">
        <div class="user-info">
            <div class="name" id="userName">Guest</div>
            <div class="role" id="userRole">Operator</div>
        </div>
        <button class="btn-logout-sm" id="logoutBtn" onclick="handleLogout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
    </div>
</div>

<div class="alert-popup" id="alertPopup">
    <span class="robot">🤖</span>
    <div class="title" id="alertTitle">OIL SPILL DETECTED</div>
    <div class="sub" id="alertSub">Bay of Bengal · 22.41°N, 88.46°E</div>
    <div class="details" id="alertDetails">🛳️ Culprit: Cargo Gamma · IMO: 7654321</div>
    <div class="voice-indicator"><span class="speaker">🔊</span><span class="label" id="voiceLabel">SPEAKING: Oil spill detected! Take immediate action!</span></div>
    <div class="sound-indicator"><span class="label">🔊 ALARM ACTIVE</span></div>
    <button class="btn-stop" onclick="stopAlert()">⏹️ Stop Alert</button>
</div>

<div class="main-content" id="mainContent">
    <!-- PAGE 1: DASHBOARD -->
    <div class="page active" id="page1">
        <div class="page-header">
            <h2>📊 <span class="highlight" id="page1Title">Mission Dashboard</span></h2>
            <p id="page1Sub">Real-time oil spill monitoring & intelligence</p>
        </div>
        <div class="grid-5">
            <div class="card"><div class="stat-number">14</div><div class="stat-label" id="statShips">Ships</div></div>
            <div class="card"><div class="stat-number" style="-webkit-text-fill-color:#4a9eff;">0</div><div class="stat-label" id="statAlerts">Alerts</div></div>
            <div class="card"><div class="stat-number warning">3</div><div class="stat-label" id="statRisks">Risks</div></div>
            <div class="card"><div class="stat-number">99.8%</div><div class="stat-label" id="statSuccess">Success</div></div>
            <div class="card"><div class="stat-number" style="-webkit-text-fill-color:#4a9eff;">100%</div><div class="stat-label" id="statCoverage">Coverage</div></div>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-title"><i class="fas fa-cloud-sun"></i> <span id="weatherTitle">Live Weather</span></div>
                <div id="weatherWidget">
                    <div style="display:flex;align-items:center;gap:15px;">
                        <span id="weatherIcon" style="font-size:40px;">☀️</span>
                        <div>
                            <div style="font-size:24px;font-family:'Orbitron',monospace;" id="weatherTemp">--°C</div>
                            <div style="color:#94a3b8;font-size:12px;" id="weatherDesc">Loading...</div>
                        </div>
                    </div>
                    <div style="display:flex;gap:15px;margin-top:10px;font-size:11px;color:#94a3b8;">
                        <span>💨 Wind: <span id="weatherWind">--</span> km/h</span>
                        <span>💧 Humidity: <span id="weatherHumidity">--</span>%</span>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-satellite"></i> <span id="satelliteTitle">Satellite Status</span></div>
                <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:#94a3b8;">
                    <span style="color:#00d4aa;">● NASA MODIS: <span id="satNasa">Online</span></span>
                    <span style="color:#00d4aa;">● ISRO RISAT: <span id="satIsro">Online</span></span>
                    <span style="color:#fbbf24;">● Sentinel-1: <span id="satSentinel">Standby</span></span>
                </div>
            </div>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-title"><i class="fas fa-chart-line"></i> <span id="aiTitle">AI Confidence</span></div>
                <div style="display:flex;align-items:center;gap:12px;">
                    <div style="font-family:'Orbitron',monospace;font-size:34px;color:#00d4aa;" id="confidenceMeter">98%</div>
                    <div style="flex:1;height:6px;background:rgba(255,255,255,0.04);border-radius:3px;overflow:hidden;">
                        <div style="width:98%;height:100%;background:linear-gradient(90deg,#4a9eff,#00d4aa);border-radius:3px;transition:width 0.5s;" id="confidenceBar"></div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-clock"></i> <span id="updateTitle">Real-time Update</span></div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="color:#00d4aa;font-size:10px;font-family:'Share Tech Mono',monospace;" id="lastUpdate">Last update: Just now</span>
                    <span style="color:#4a9eff;font-size:8px;" id="updateCounter">⏳ 0s</span>
                </div>
            </div>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-title"><i class="fas fa-wave-square"></i> <span id="liveStream">Live Data Stream</span></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:11px;">
                    <div><span style="color:#4a9eff;" id="oilDensityLabel">Oil Density</span>: <span id="liveOilDensity">--</span> µg/L</div>
                    <div><span style="color:#4a9eff;" id="spreadRateLabel">Spread Rate</span>: <span id="liveSpreadRate">--</span> km/h</div>
                    <div><span style="color:#4a9eff;" id="confidenceLabel">Confidence</span>: <span id="liveConfidence">--</span>%</div>
                    <div><span style="color:#4a9eff;" id="vesselsLabel">Vessels</span>: <span id="liveVessels">--</span></div>
                </div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-download"></i> <span id="exportTitle">Export</span></div>
                <button class="btn btn-success" onclick="exportReport()"><i class="fas fa-file-csv"></i> <span id="exportCSV">Export CSV</span></button>
                <button class="btn btn-primary" onclick="exportReportJSON()"><i class="fas fa-file-code"></i> <span id="exportJSON">Export JSON</span></button>
            </div>
        </div>
        <div class="mission-log" id="missionLog">
            <div class="log-entry"><span class="time">00:00:00</span><span class="msg">🚀 Mission OCEAN EYE initialized</span></div>
            <div class="log-entry"><span class="time">00:00:00</span><span class="msg">📡 Systems online - awaiting command</span></div>
        </div>
    </div>

    <!-- PAGE 2: MAP -->
    <div class="page" id="page2">
        <div class="page-header">
            <h2>🗺️ <span class="highlight" id="mapTitle">Live Maritime Map</span></h2>
            <p id="mapSub">Select a scenario to simulate oil spill</p>
        </div>
        <div class="scenario-selector">
            <div class="scenario-card natural" onclick="selectScenario('natural')"><span class="icon">🌊</span><div class="title" id="scNatural">Natural</div><div class="desc" id="scNaturalDesc">Seepage</div><span class="badge">🌱</span></div>
            <div class="scenario-card culprit" onclick="selectScenario('culprit')"><span class="icon">🛳️</span><div class="title" id="scCulprit">Culprit</div><div class="desc" id="scCulpritDesc">Theft</div><span class="badge">🚨</span></div>
            <div class="scenario-card internal" onclick="selectScenario('internal')"><span class="icon">⚙️</span><div class="title" id="scInternal">Internal</div><div class="desc" id="scInternalDesc">Failure</div><span class="badge">⚠️</span></div>
            <div class="scenario-card collision" onclick="selectScenario('collision')"><span class="icon">💥</span><div class="title" id="scCollision">Collision</div><div class="desc" id="scCollisionDesc">Accident</div><span class="badge">💢</span></div>
            <div class="scenario-card fire" onclick="selectScenario('fire')"><span class="icon">🔥</span><div class="title" id="scFire">Fire</div><div class="desc" id="scFireDesc">Explosion</div><span class="badge">🚒</span></div>
            <div class="scenario-card weather" onclick="selectScenario('weather')"><span class="icon">🌀</span><div class="title" id="scWeather">Weather</div><div class="desc" id="scWeatherDesc">Storm</div><span class="badge">🌪️</span></div>
        </div>
        <div class="map-wrapper" style="margin-top:10px;">
            <div id="map"></div>
            <div class="map-legend">
                <span class="item"><span class="color green"></span> <span id="legendSpill">Spill</span></span>
                <span class="item">🚢 <span id="legendVessel">Vessel</span></span>
                <span class="item"><span class="color yellow"></span> <span id="legendSTS">STS</span></span>
                <span class="item"><span class="color blue"></span> <span id="legendNatural">Natural</span></span>
                <span class="item"><span class="color red"></span> <span id="legendRisk">High Risk</span></span>
            </div>
        </div>
        <div id="scenarioStatus" style="margin-top:8px;padding:6px 12px;background:rgba(255,255,255,0.005);border-radius:4px;border:1px solid rgba(255,255,255,0.005);display:none;">
            <div style="display:flex;align-items:center;gap:6px;">
                <span id="statusIcon" style="font-size:18px;">✅</span>
                <div>
                    <div style="font-weight:600;font-size:12px;font-family:'Orbitron',monospace;" id="statusTitle">Scenario Activated</div>
                    <div style="color:#94a3b8;font-size:9px;" id="statusDesc">Description</div>
                </div>
            </div>
        </div>
        <div class="btn-group">
            <button class="btn btn-danger" onclick="triggerAlertFromMap()"><i class="fas fa-bell"></i> <span id="triggerAlert">Trigger Alert</span></button>
            <button class="btn btn-primary" onclick="showPage('page4')"><i class="fas fa-arrow-right"></i> <span id="goToAlert">Go to Alert</span></button>
        </div>
    </div>

    <!-- PAGE 3: SATELLITE -->
    <div class="page" id="page3">
        <div class="page-header">
            <h2>🛰️ <span class="highlight" id="satelliteTitle">Satellite Analysis</span></h2>
            <p id="satelliteSub">Real-time satellite data with raw telemetry</p>
        </div>
        <div class="satellite-scanner">
            <div class="scan-overlay"></div>
            <div class="card-title"><i class="fas fa-satellite-dish"></i> <span id="sarTitle">SAR Satellite Scanner</span></div>
            <div class="sat-img" id="satImg">
                🛰️
                <div class="scan-line" id="scanLine"></div>
                <div class="label" id="scanLabel">Press "Scan" to start</div>
            </div>
            <div class="scan-stats">
                <span><span id="statusLabel">Status</span>: <span id="scanStatus" style="color:#64748b;">Ready</span></span>
                <span><span id="coverageLabel">Coverage</span>: 250km²</span>
            </div>
            <div class="analysis-result">
                <span class="item">🟢 <span id="oilLabel">Oil</span>: <span id="oilResult" style="color:#64748b;">--</span></span>
                <span class="item">🚢 <span id="shipsLabel">Ships</span>: <span id="shipsResult" style="color:#64748b;">--</span></span>
                <span class="item">⛴️ <span id="formationLabel">Formation</span>: <span id="formationResult" style="color:#64748b;">--</span></span>
            </div>
            <div class="btn-group">
                <button class="btn btn-primary" onclick="runSatelliteScan()"><i class="fas fa-play"></i> <span id="startScan">Start Scan</span></button>
                <button class="btn btn-outline" onclick="resetSatellite()"><i class="fas fa-undo"></i> <span id="resetBtn">Reset</span></button>
            </div>
        </div>
        <div class="card" style="margin-top:12px;">
            <div class="card-title"><i class="fas fa-database"></i> <span id="rawTitle">RAW SATELLITE DATA TELEMETRY</span></div>
            <div class="raw-data" id="rawDataDisplay">
                <div class="data-line"><span class="key">STATUS:</span><span class="value" id="rawStatus">AWAITING COMMAND</span></div>
                <div class="data-line"><span class="key">LATITUDE:</span><span class="value" id="rawLat">22.4100°N</span></div>
                <div class="data-line"><span class="key">LONGITUDE:</span><span class="value" id="rawLon">88.4600°E</span></div>
                <div class="data-line"><span class="key">SAR BAND:</span><span class="value" id="rawBand">C-BAND</span></div>
                <div class="data-line"><span class="key">RESOLUTION:</span><span class="value" id="rawRes">10m/pixel</span></div>
                <div class="data-line"><span class="key">POLARIZATION:</span><span class="value" id="rawPol">VV/VH</span></div>
                <div class="data-line"><span class="key">INCIDENT ANGLE:</span><span class="value" id="rawAngle">34.2°</span></div>
                <div class="data-line"><span class="key">SIGNAL STRENGTH:</span><span class="value" id="rawSignal">-12.4 dB</span></div>
                <div class="data-line"><span class="key">OIL DETECTION:</span><span class="value" id="rawOil">PENDING</span></div>
                <div class="data-line"><span class="key">CONFIDENCE:</span><span class="value" id="rawConf">0%</span></div>
            </div>
        </div>
        <div class="grid-3" style="margin-top:12px;">
            <div class="card">
                <div class="card-title"><i class="fas fa-radio"></i> <span id="aisTitle">AIS Data</span></div>
                <div style="font-size:12px;color:#94a3b8;"><span id="activeShips">Active Ships</span>: <span id="aisShips">12</span></div>
                <div style="font-size:12px;color:#94a3b8;"><span id="suspiciousLabel">Suspicious</span>: <span id="aisSuspicious">2</span></div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-microscope"></i> <span id="triboTitle">Triboelectric</span></div>
                <div style="font-size:12px;color:#94a3b8;"><span id="triboStatusLabel">Status</span>: <span style="color:#00d4aa;" id="triboStatus">● Online</span></div>
                <div style="font-size:12px;color:#94a3b8;"><span id="triboSens">Sensitivity</span>: <span id="triboSensVal">High</span></div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-drone"></i> <span id="uavTitle">UAV Status</span></div>
                <div style="font-size:12px;color:#94a3b8;"><span id="uavDrones">Drones</span>: <span id="uavCount">3</span> <span id="uavActive">Active</span></div>
                <div style="font-size:12px;color:#94a3b8;"><span id="uavCoverLabel">Coverage</span>: <span id="uavCoverage">85%</span></div>
            </div>
        </div>
    </div>

    <!-- PAGE 4: ALERT -->
    <div class="page" id="page4">
        <div class="page-header">
            <h2>🤖 <span class="highlight" id="alertTitle">Alert System</span></h2>
            <p id="alertSub">AI robot voice alert with continuous alarm</p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;padding:20px 0;">
            <div style="font-size:80px;margin-bottom:10px;animation:float 3s ease-in-out infinite;">🤖</div>
            <div style="font-family:'Orbitron',monospace;font-size:18px;font-weight:700;color:#4a9eff;margin-bottom:5px;" id="alertStatusText">System Ready</div>
            <div style="color:#94a3b8;font-size:12px;font-family:'Share Tech Mono',monospace;" id="alertMessageText">Awaiting command</div>
            <div class="btn-group" style="margin-top:15px;">
                <button class="btn btn-danger" onclick="triggerNaturalAlert()"><i class="fas fa-water"></i> <span id="btnNatural">Natural Spill</span></button>
                <button class="btn btn-danger" onclick="triggerCulpritAlert()"><i class="fas fa-ship"></i> <span id="btnCulprit">Culprit Theft</span></button>
                <button class="btn btn-danger" onclick="triggerInternalAlert()"><i class="fas fa-exclamation-triangle"></i> <span id="btnInternal">Internal Failure</span></button>
                <button class="btn btn-danger" onclick="triggerCollisionAlert()"><i class="fas fa-car-crash"></i> <span>Collision</span></button>
                <button class="btn btn-danger" onclick="triggerFireAlert()"><i class="fas fa-fire"></i> <span>Fire</span></button>
                <button class="btn btn-danger" onclick="triggerWeatherAlert()"><i class="fas fa-cloud-rain"></i> <span>Weather</span></button>
            </div>
            <div class="btn-group">
                <button class="btn btn-outline" onclick="showPage('page2')"><i class="fas fa-arrow-left"></i> <span id="backMap">Map</span></button>
                <button class="btn btn-success" onclick="showPage('page5')"><i class="fas fa-chart-bar"></i> <span id="analysisBtn">Analysis</span></button>
            </div>
        </div>
    </div>

    <!-- PAGE 5: ANALYSIS -->
    <div class="page" id="page5">
        <div class="page-header">
            <h2>📈 <span class="highlight" id="analysisTitle">Data Analysis</span></h2>
            <p id="analysisSub">Oil spill trends, statistics & visualizations</p>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-title"><i class="fas fa-chart-area"></i> <span id="spreadTrend">Oil Spread Trend</span></div>
                <canvas id="spreadChart" height="200"></canvas>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-chart-pie"></i> <span id="spillTypes">Spill Types</span></div>
                <canvas id="pieChart" height="200"></canvas>
            </div>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-title"><i class="fas fa-chart-bar"></i> <span id="monthlyComp">Monthly Comparison</span></div>
                <canvas id="barChart" height="200"></canvas>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-clock"></i> <span id="responseTitle">Response Time</span></div>
                <div style="font-family:'Orbitron',monospace;font-size:30px;color:#00d4aa;">4.2 min</div>
                <div style="color:#94a3b8;font-size:9px;" id="avgResponse">Average response time</div>
                <div style="margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:5px;font-size:11px;">
                    <div><span style="color:#4a9eff;" id="minLabel">Min</span>: 2.1 min</div>
                    <div><span style="color:#4a9eff;" id="maxLabel">Max</span>: 8.7 min</div>
                </div>
            </div>
        </div>
    </div>

    <!-- PAGE 6: SETTINGS -->
    <div class="page" id="page6">
        <div class="page-header">
            <h2>⚙️ <span class="highlight" id="settingsTitle">Settings</span></h2>
            <p id="settingsSub">Configure your mission control</p>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-title"><i class="fas fa-language"></i> <span id="langTitle">Language</span></div>
                <div class="language-selector">
                    <button class="lang-btn active" onclick="setLanguage('en')">EN</button>
                    <button class="lang-btn" onclick="setLanguage('hi')">हिन्दी</button>
                    <button class="lang-btn" onclick="setLanguage('es')">ES</button>
                    <button class="lang-btn" onclick="setLanguage('fr')">FR</button>
                    <button class="lang-btn" onclick="setLanguage('ar')">عربي</button>
                    <button class="lang-btn" onclick="setLanguage('zh')">中文</button>
                </div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-palette"></i> <span id="themeTitle">Theme</span></div>
                <div style="display:flex;gap:10px;">
                    <button class="btn btn-primary btn-sm" onclick="setTheme('dark')">🌙 <span id="themeDark">Dark</span></button>
                    <button class="btn btn-outline btn-sm" onclick="setTheme('light')">☀️ <span id="themeLight">Light</span></button>
                </div>
            </div>
        </div>
        <div class="grid-2" style="margin-top:12px;">
            <div class="card">
                <div class="card-title"><i class="fas fa-sms"></i> <span id="smsTitle">SMS Fallback</span></div>
                <div class="sms-config">
                    <label><input type="checkbox" id="smsToggle" onclick="toggleSMS()"> <span id="smsEnable">Enable SMS Alerts</span></label>
                    <input type="text" id="smsNumber" placeholder="+91 98765 43210" value="+919876543210">
                </div>
                <div style="font-size:9px;color:#64748b;font-family:'Share Tech Mono',monospace;" id="smsStatus">📡 SMS: Disabled</div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-bell"></i> <span id="notifTitle">Notifications</span></div>
                <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:#94a3b8;">
                    <label><input type="checkbox" checked> <span id="notifPush">Push Notifications</span></label>
                    <label><input type="checkbox" checked> <span id="notifEmail">Email Alerts</span></label>
                    <label><input type="checkbox" checked> <span id="notifSMS">SMS Alerts</span></label>
                </div>
            </div>
        </div>
        <div class="grid-2" style="margin-top:12px;">
            <div class="card">
                <div class="card-title"><i class="fas fa-robot"></i> <span id="aiSettingsTitle">AI Settings</span></div>
                <div style="font-size:11px;color:#94a3b8;">
                    <div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Confidence Threshold</span><span id="confThreshold">85%</span></div>
                    <div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Model Version</span><span id="modelVersion">v2.4.1</span></div>
                    <div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Last Retrained</span><span id="lastRetrain">2026-09-08</span></div>
                </div>
                <button class="btn btn-primary btn-sm" onclick="retrainModel()"><i class="fas fa-sync"></i> Retrain Model</button>
            </div>
            <div class="card">
                <div class="card-title"><i class="fas fa-cog"></i> <span id="systemTitle">System</span></div>
                <div style="font-size:11px;color:#94a3b8;">
                    <div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Version</span><span id="systemVersion">2.0.0</span></div>
                    <div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Uptime</span><span id="systemUptime">Loading...</span></div>
                    <div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Environment</span><span id="systemEnv">Production</span></div>
                </div>
                <button class="btn btn-outline btn-sm" onclick="clearData()"><i class="fas fa-trash"></i> Clear Cache</button>
            </div>
        </div>
    </div>

    <!-- PAGE 7: IMAGE ANALYSIS -->
    <div class="page" id="page7">
        <div class="page-header">
            <h2>📷 <span class="highlight" id="imageTitle">Browse & Analyze Image</span></h2>
            <p id="imageSub">Upload a satellite image to detect oil spills</p>
        </div>
        <div class="card">
            <div class="card-title"><i class="fas fa-upload"></i> <span id="uploadTitle">Upload Image</span></div>
            <div style="display:flex;gap:15px;flex-wrap:wrap;align-items:center;">
                <input type="file" id="imageInput" accept="image/*" style="display:none;">
                <button class="btn btn-primary" onclick="document.getElementById('imageInput').click()"><i class="fas fa-folder-open"></i> <span id="browseBtn">Browse</span></button>
                <button class="btn btn-success" id="analyzeBtn"><i class="fas fa-microscope"></i> <span id="analyzeBtnText">Analyze</span></button>
                <span style="color:#94a3b8;font-size:11px;" id="fileName">No file selected</span>
            </div>
            <div id="analysisResult" style="margin-top:15px;padding:12px 16px;background:rgba(255,255,255,0.01);border-radius:6px;border:1px solid rgba(255,255,255,0.02);min-height:50px;display:flex;align-items:center;font-family:'Orbitron',monospace;font-size:14px;color:#94a3b8;">
                ⏳ Waiting for image...
            </div>
        </div>
    </div>

    <!-- PAGE 8: REVIEW QUEUE -->
    <div class="page" id="page8">
        <div class="page-header">
            <h2>🧠 <span class="highlight" id="reviewTitle">Review Queue</span></h2>
            <p id="reviewSub">Human verification for borderline confidence cases</p>
        </div>
        <div id="reviewList" style="margin-top:12px;">
            <div class="review-item">
                <div class="preview">🛢️</div>
                <div class="info">
                    <div class="title">Case #001 - Bay of Bengal</div>
                    <div class="sub">Confidence: 82% · 2026-09-08 14:32 · ⏳ Pending</div>
                </div>
                <div class="actions">
                    <button class="btn btn-success btn-sm" onclick="approveReview(this)">✅ Approve</button>
                    <button class="btn btn-danger btn-sm" onclick="rejectReview(this)">❌ Reject</button>
                    <button class="btn btn-warning btn-sm" onclick="escalateReview(this)">⬆️ Escalate</button>
                </div>
            </div>
            <div class="review-item">
                <div class="preview">🌊</div>
                <div class="info">
                    <div class="title">Case #002 - Andaman Sea</div>
                    <div class="sub">Confidence: 78% · 2026-09-08 12:15 · ⏳ Pending</div>
                </div>
                <div class="actions">
                    <button class="btn btn-success btn-sm" onclick="approveReview(this)">✅ Approve</button>
                    <button class="btn btn-danger btn-sm" onclick="rejectReview(this)">❌ Reject</button>
                    <button class="btn btn-warning btn-sm" onclick="escalateReview(this)">⬆️ Escalate</button>
                </div>
            </div>
            <div class="review-item">
                <div class="preview">🚢</div>
                <div class="info">
                    <div class="title">Case #003 - Gulf of Mannar</div>
                    <div class="sub">Confidence: 76% · 2026-09-08 10:45 · ⏳ Pending</div>
                </div>
                <div class="actions">
                    <button class="btn btn-success btn-sm" onclick="approveReview(this)">✅ Approve</button>
                    <button class="btn btn-danger btn-sm" onclick="rejectReview(this)">❌ Reject</button>
                    <button class="btn btn-warning btn-sm" onclick="escalateReview(this)">⬆️ Escalate</button>
                </div>
            </div>
        </div>
        <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;">
            <span style="font-size:10px;color:#64748b;font-family:'Share Tech Mono',monospace;">📊 Pending: <span id="pendingCount">3</span></span>
            <span style="font-size:10px;color:#00d4aa;font-family:'Share Tech Mono',monospace;">✅ Approved: <span id="approvedCount">0</span></span>
            <span style="font-size:10px;color:#f87171;font-family:'Share Tech Mono',monospace;">❌ Rejected: <span id="rejectedCount">0</span></span>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// =========================================
// CHECK LOGIN - Redirect if not logged in
// =========================================
(function() {
    const user = localStorage.getItem('oilSpillUser');
    if (!user) {
        window.location.href = 'login.html';
        return;
    }
    try {
        const parsed = JSON.parse(user);
        if (!parsed.email) {
            window.location.href = 'login.html';
            return;
        }
        document.getElementById('userName').textContent = parsed.name || parsed.email;
        document.getElementById('userRole').textContent = parsed.role || 'Operator';
        if (parsed.avatar) {
            document.getElementById('userAvatar').src = parsed.avatar;
            document.getElementById('userAvatar').style.display = 'inline-block';
        }
        applyRBAC(parsed.role || 'operator');
    } catch(e) {
        window.location.href = 'login.html';
    }
})();

function applyRBAC(role) {
    const items = document.querySelectorAll('.nav-item[data-role]');
    items.forEach(item => {
        const roles = item.dataset.role.split(',');
        if (roles.includes('all') || roles.includes(role)) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
    const roleMap = {
        'isro': { class: 'isro', label: '🛰️ ISRO' },
        'coastguard': { class: 'coastguard', label: '⚓ Coast Guard' },
        'dgship': { class: 'dgship', label: '⚓ DG Shipping' },
        'admin': { class: 'admin', label: '👑 Admin' },
        'operator': { class: 'operator', label: '👤 Operator' }
    };
    const roleInfo = roleMap[role] || roleMap['operator'];
    document.getElementById('userRole').textContent = roleInfo.label;
}

function handleLogout() {
    localStorage.removeItem('oilSpillUser');
    window.location.href = 'login.html';
}

