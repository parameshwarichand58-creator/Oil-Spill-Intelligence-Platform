let currentLang = 'en';

function setLanguage(lang) {
    currentLang = lang;
    const t = translations[lang] || translations.en;
    
    const ids = [
        'appTitle','appStatus','navDashboard','navImage','navMap','navSatellite','navAlert','navAnalysis','navSettings','navReview',
        'page1Title','page1Sub','statShips','statAlerts','statRisks','statSuccess','statCoverage',
        'weatherTitle','satelliteTitle','aiTitle','updateTitle',
        'liveStream','oilDensityLabel','spreadRateLabel','confidenceLabel','vesselsLabel',
        'exportTitle','exportCSV','exportJSON',
        'mapTitle','mapSub','scNatural','scNaturalDesc','scCulprit','scCulpritDesc',
        'scInternal','scInternalDesc','scCollision','scCollisionDesc','scFire','scFireDesc','scWeather','scWeatherDesc',
        'legendSpill','legendVessel','legendSTS','legendNatural','legendRisk','triggerAlert','goToAlert',
        'satelliteTitle','satelliteSub','sarTitle','statusLabel','coverageLabel',
        'oilLabel','shipsLabel','formationLabel','startScan','resetBtn','rawTitle',
        'aisTitle','activeShips','suspiciousLabel','triboTitle','triboStatusLabel','triboSens',
        'uavTitle','uavDrones','uavActive','uavCoverLabel',
        'alertTitle','alertSub','btnNatural','btnCulprit','btnInternal','backMap','analysisBtn',
        'analysisTitle','analysisSub','spreadTrend','spillTypes',
        'monthlyComp','responseTitle','avgResponse','minLabel','maxLabel',
        'settingsTitle','settingsSub','langTitle','themeTitle','themeDark','themeLight',
        'smsTitle','smsEnable','notifTitle','notifPush','notifEmail','notifSMS',
        'systemReady','awaitingCommand',
        'imageTitle','imageSub','uploadTitle','browseBtn','analyzeBtnText',
        'reviewTitle','reviewSub','aiSettingsTitle','systemTitle'
    ];
    
    for (let i = 0; i < ids.length; i++) {
        const el = document.getElementById(ids[i]);
        if (el && t[ids[i]]) {
            el.textContent = t[ids[i]];
        }
    }
    
    if (spreadChartInstance) {
        spreadChartInstance.data.datasets[0].label = t.spreadTrend || 'Oil Spread (km²)';
        spreadChartInstance.update();
    }
    if (pieChartInstance) {
        pieChartInstance.data.labels = [t.typeNatural || 'Natural', t.typeHuman || 'Human-caused', t.typeTech || 'Technical'];
        pieChartInstance.update();
    }
    if (barChartInstance) {
        barChartInstance.data.datasets[0].label = t.monthlyComp || 'Detected';
        barChartInstance.update();
    }
    
    document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.lang-btn').forEach(b => {
        if (b.textContent.toLowerCase() === lang || b.textContent === lang.toUpperCase()) {
            b.classList.add('active');
        }
    });
    
    localStorage.setItem('appLang', lang);
    showToast('🌍 Language changed to ' + (t.langTitle || lang).toUpperCase(), 'success');
}

function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    if (!container) {
        const newContainer = document.createElement('div');
        newContainer.id = 'toastContainer';
        newContainer.className = 'toast-container';
        document.body.appendChild(newContainer);
    }
    const toastContainer = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = 'toast ' + type;
    const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
    toast.innerHTML = '<div style="display:flex;align-items:center;gap:10px;">' +
        '<span style="font-size:20px;">' + (icons[type] || 'ℹ️') + '</span>' +
        '<span style="flex:1;font-size:13px;">' + message + '</span>' +
        '<button class="close-toast" onclick="this.parentElement.parentElement.remove()">✕</button>' +
        '</div>';
    toastContainer.appendChild(toast);
    setTimeout(function() { if (toast.parentElement) toast.remove(); }, 5000);
}

function showPage(pageId) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById(pageId).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    const map = {'page1':'Dashboard','page2':'Map','page3':'Satellite','page4':'Alert','page5':'Analysis','page6':'Settings','page7':'Image Analysis','page8':'Review Queue'};
    document.querySelectorAll('.nav-item').forEach(n => {
        const label = n.querySelector('.label');
        if(label && label.textContent === map[pageId]) n.classList.add('active');
    });
    if(pageId === 'page2' && mapInstance) setTimeout(() => mapInstance.invalidateSize(), 300);
    if(pageId === 'page5') setTimeout(initCharts, 100);
}

let mapInstance = null;
let currentScenario = 'none';
let alertActive = false;
let soundInterval = null;
let speechInterval = null;
let soundActive = false;

function initMap() {
    const c = document.getElementById('map');
    if(!c) { setTimeout(initMap,500); return; }
    try {
        if(c.offsetWidth===0 || c.offsetHeight===0) { setTimeout(initMap,500); return; }
        mapInstance = L.map('map', { center:[22.41,88.46], zoom:13, zoomControl:true });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution:'© OpenStreetMap', maxZoom:19 }).addTo(mapInstance);
        L.marker([22.41,88.46], { icon:L.divIcon({ html:'🛢️', iconSize:[20,20] }) }).addTo(mapInstance).bindPopup('🛢️ Oil Spill<br>Bay of Bengal');
        L.circle([22.41,88.46], { color:'#00d4aa', fillColor:'#00d4aa', fillOpacity:0.06, radius:1500 }).addTo(mapInstance);
        const sts = [{lat:22.38,lng:88.44,name:'STS 1'},{lat:22.40,lng:88.46,name:'STS 2'}];
        sts.forEach(s => { L.marker([s.lat,s.lng], { icon:L.divIcon({ html:'⛴️', iconSize:[16,16] }) }).addTo(mapInstance).bindPopup(s.name); L.circle([s.lat,s.lng], { color:'#fbbf24', fillColor:'#fbbf24', fillOpacity:0.03, radius:300 }).addTo(mapInstance); });
        L.polyline([[22.38,88.44],[22.40,88.46]], { color:'#fbbf24', weight:1, dashArray:'5,5', opacity:0.2 }).addTo(mapInstance).bindPopup('🔄 STS Transfer');
        const vessels = [{lat:22.35,lng:88.38,name:'Tanker Alpha'},{lat:22.45,lng:88.52,name:'Tanker Beta'},{lat:22.40,lng:88.42,name:'Cargo Gamma'},{lat:22.28,lng:88.50,name:'Unknown'}];
        vessels.forEach(v => { L.marker([v.lat,v.lng], { icon:L.divIcon({ html:'🚢', iconSize:[14,14] }) }).addTo(mapInstance).bindPopup(v.name); });
        
        L.circle([22.41,88.46], { color:'#ef4444', fillColor:'#ef4444', fillOpacity:0.03, radius:2500 }).addTo(mapInstance).bindPopup('⚠️ High Risk Zone');
        L.circle([22.35,88.38], { color:'#fbbf24', fillColor:'#fbbf24', fillOpacity:0.02, radius:1800 }).addTo(mapInstance).bindPopup('🟡 Medium Risk Zone');
        L.circle([22.28,88.50], { color:'#4a9eff', fillColor:'#4a9eff', fillOpacity:0.01, radius:1200 }).addTo(mapInstance).bindPopup('🟢 Low Risk Zone');
        
        setTimeout(() => mapInstance.invalidateSize(), 500);
        showToast('🗺️ Map loaded!', 'success');
    } catch(e) {
        document.getElementById('map').innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#64748b;flex-direction:column;gap:4px;"><span style="font-size:28px;">🗺️</span><p style="font-size:12px;font-family:Orbitron,monospace;">Bay of Bengal</p></div>';
    }
}

function selectScenario(type) {
    currentScenario = type;
    document.querySelectorAll('.scenario-card').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.scenario-card').forEach(c => { if(c.classList.contains(type)) c.classList.add('active'); });
    const names = { natural:'Natural Seepage', culprit:'Culprit Theft', internal:'Internal Failure', collision:'Collision Spill', fire:'Fire/Explosion', weather:'Weather Spill' };
    const icons = { natural:'🌊', culprit:'🛳️', internal:'⚙️', collision:'💥', fire:'🔥', weather:'🌀' };
    document.getElementById('statusIcon').textContent = icons[type] || '✅';
    document.getElementById('statusTitle').textContent = names[type] || 'Scenario';
    document.getElementById('statusDesc').textContent = 'Click "Trigger Alert" to activate';
    document.getElementById('scenarioStatus').style.display = 'block';
    showToast('📌 ' + names[type] + ' selected', 'info');
    if(mapInstance) {
        mapInstance.eachLayer(layer => { if(layer._url) return; mapInstance.removeLayer(layer); });
        const color = type === 'natural' ? '#4a9eff' : '#ef4444';
        const icon = type === 'natural' ? '🌊' : '🛢️';
        L.marker([22.41,88.46], { icon:L.divIcon({ html:icon, iconSize:[20,20] }) }).addTo(mapInstance).bindPopup('Oil Spill<br>Bay of Bengal');
        L.circle([22.41,88.46], { color:color, fillColor:color, fillOpacity:0.08, radius:1500 }).addTo(mapInstance);
        L.circle([22.41,88.46], { color:'#ef4444', fillColor:'#ef4444', fillOpacity:0.03, radius:2500 }).addTo(mapInstance).bindPopup('⚠️ High Risk Zone');
        L.circle([22.35,88.38], { color:'#fbbf24', fillColor:'#fbbf24', fillOpacity:0.02, radius:1800 }).addTo(mapInstance).bindPopup('🟡 Medium Risk Zone');
        L.circle([22.28,88.50], { color:'#4a9eff', fillColor:'#4a9eff', fillOpacity:0.01, radius:1200 }).addTo(mapInstance).bindPopup('🟢 Low Risk Zone');
        const sts = [{lat:22.38,lng:88.44,name:'STS 1'},{lat:22.40,lng:88.46,name:'STS 2'}];
        sts.forEach(s => { L.marker([s.lat,s.lng], { icon:L.divIcon({ html:'⛴️', iconSize:[16,16] }) }).addTo(mapInstance).bindPopup(s.name); L.circle([s.lat,s.lng], { color:'#fbbf24', fillColor:'#fbbf24', fillOpacity:0.03, radius:300 }).addTo(mapInstance); });
        L.polyline([[22.38,88.44],[22.40,88.46]], { color:'#fbbf24', weight:1, dashArray:'5,5', opacity:0.2 }).addTo(mapInstance).bindPopup('🔄 STS Transfer');
        const vessels = [{lat:22.35,lng:88.38,name:'Tanker Alpha'},{lat:22.45,lng:88.52,name:'Tanker Beta'},{lat:22.40,lng:88.42,name:'Cargo Gamma'},{lat:22.28,lng:88.50,name:'Unknown'}];
        vessels.forEach(v => { L.marker([v.lat,v.lng], { icon:L.divIcon({ html:'🚢', iconSize:[14,14] }) }).addTo(mapInstance).bindPopup(v.name); });
        if(type === 'natural') L.circle([22.41,88.46], { color:'#4a9eff', fillColor:'#4a9eff', fillOpacity:0.08, radius:3000 }).addTo(mapInstance).bindPopup('🌊 Natural Seepage');
        setTimeout(() => mapInstance.invalidateSize(), 300);
    }
}

// =========================================
// SMS FALLBACK - WORKING SIMULATION
// =========================================
let smsEnabled = false;

function toggleSMS() {
    smsEnabled = document.getElementById('smsToggle').checked;
    const status = document.getElementById('smsStatus');
    if (smsEnabled) {
        status.innerHTML = '📡 SMS: Enabled ✅';
        status.style.color = '#00d4aa';
        showToast('📱 SMS Alerts Enabled', 'success');
        console.log('📱 SMS Enabled');
    } else {
        status.innerHTML = '📡 SMS: Disabled';
        status.style.color = '#64748b';
        showToast('📱 SMS Alerts Disabled', 'info');
        console.log('📱 SMS Disabled');
    }
}

function sendSMS(message) {
    console.log('📱 sendSMS called, smsEnabled:', smsEnabled);
    if (!smsEnabled) {
        console.log('📱 SMS disabled - not sending');
        return;
    }
    const phoneNumber = document.getElementById('smsNumber').value || '+919876543210';
    console.log('📱 Sending SMS to:', phoneNumber, 'Message:', message);
    
    // SIMULATED SMS - shows toast notification
    showToast('📱 SMS sent to ' + phoneNumber, 'success');
    document.getElementById('smsStatus').innerHTML = '📡 SMS: Sent ✅';
    document.getElementById('smsStatus').style.color = '#00d4aa';
    
    console.log('📱 [SIMULATED] SMS sent to ' + phoneNumber + ': ' + message);
}

// =========================================
// ALERT SYSTEM (Updated with SMS)
// =========================================
function speakMessage(msg) {
    if(!soundActive) return;
    try {
        if(window.speechSynthesis) {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(msg);
            u.lang='en-US'; u.rate=0.85; u.pitch=1; u.volume=1;
            window.speechSynthesis.speak(u);
        }
    } catch(e){}
}

function startAlert(msg, title, details) {
    if(soundActive) return;
    soundActive = true;
    alertActive = true;
    document.getElementById('alertPopup').classList.add('show');
    document.getElementById('alertTitle').textContent = title;
    document.getElementById('alertDetails').textContent = details;
    document.getElementById('voiceLabel').textContent = '🔴 SPEAKING: "'+msg+'"';
    document.getElementById('alertStatusText').textContent = '🚨 ALERT ACTIVE';
    document.getElementById('alertMessageText').textContent = msg;
    document.getElementById('alertBadge').style.display = 'inline-block';
    document.getElementById('alertBadge').textContent = parseInt(document.getElementById('alertBadge').textContent || '0') + 1;
    showToast('🚨 ' + title + ' - ' + msg, 'error');
    setTimeout(() => speakMessage(msg), 300);
    
    console.log('📱 Checking SMS - smsEnabled:', smsEnabled);
    if (smsEnabled) {
        sendSMS('🚨 ALERT: ' + title + ' - ' + msg);
    }
    
    speechInterval = setInterval(() => { if(soundActive && alertActive) speakMessage(msg); else { clearInterval(speechInterval); speechInterval=null; } }, 4500);
    soundInterval = setInterval(() => {
        if(!soundActive || !alertActive){ clearInterval(soundInterval); soundInterval=null; return; }
        try { const ctx = new(window.AudioContext||window.webkitAudioContext)(); const osc=ctx.createOscillator(); const gain=ctx.createGain(); osc.connect(gain); gain.connect(ctx.destination); osc.frequency.value=880; osc.type='square'; gain.gain.value=0.04; osc.start(); setTimeout(() => osc.stop(),150); } catch(e){}
    }, 600);
}

function stopAlert() {
    soundActive = false;
    alertActive = false;
    if(soundInterval){ clearInterval(soundInterval); soundInterval=null; }
    if(speechInterval){ clearInterval(speechInterval); speechInterval=null; }
    if(window.speechSynthesis) window.speechSynthesis.cancel();
    document.getElementById('alertPopup').classList.remove('show');
    document.getElementById('alertStatusText').textContent = 'System Ready';
    document.getElementById('alertMessageText').textContent = 'Awaiting command';
    document.getElementById('alertBadge').style.display = 'none';
    showToast('⏹️ Alert stopped', 'info');
}

function triggerAlertFromMap() {
    if(currentScenario === 'none'){ showToast('⚠️ Select a scenario first!', 'warning'); return; }
    const msgs = { natural:'Natural oil seepage detected. No vessel involved.', culprit:'Oil spill detected! Cargo Gamma attempted illegal oil theft!', internal:'Internal failure on Cargo Gamma. Mechanical pipe burst!', collision:'Collision detected between two vessels! Oil spill spreading.', fire:'Fire and explosion on oil rig! Emergency response needed.', weather:'Storm caused oil release! Containment required.' };
    const details = { natural:'🌊 Natural seepage - No vessel', culprit:'🛳️ Culprit: Cargo Gamma · IMO: 7654321', internal:'⚙️ Ship: Cargo Gamma · IMO: 7654321', collision:'💥 Vessels: Tanker Alpha & Unknown', fire:'🔥 Oil rig: Platform 7', weather:'🌀 Tropical storm warning' };
    const titles = { natural:'NATURAL SEEPAGE', culprit:'OIL SPILL DETECTED', internal:'INTERNAL FAILURE', collision:'COLLISION SPILL', fire:'FIRE/EXPLOSION', weather:'WEATHER SPILL' };
    startAlert(msgs[currentScenario], titles[currentScenario], details[currentScenario]);
    showPage('page4');
}

function triggerNaturalAlert() { startAlert('Natural oil seepage detected. No vessel involved. Take environmental action.', 'NATURAL SEEPAGE', '🌊 Natural seepage - No vessel'); }
function triggerCulpritAlert() { startAlert('Oil spill detected! Cargo Gamma attempted illegal oil theft! Take immediate action!', 'OIL SPILL DETECTED', '🛳️ Culprit: Cargo Gamma · IMO: 7654321'); }
function triggerInternalAlert() { startAlert('Internal failure on Cargo Gamma. Mechanical pipe burst! Take immediate action!', 'INTERNAL FAILURE', '⚙️ Ship: Cargo Gamma · IMO: 7654321'); }
function triggerCollisionAlert() { startAlert('Collision detected between two vessels! Oil spill spreading.', 'COLLISION SPILL', '💥 Vessels: Tanker Alpha & Unknown'); }
function triggerFireAlert() { startAlert('Fire and explosion on oil rig! Emergency response needed.', 'FIRE/EXPLOSION', '🔥 Oil rig: Platform 7'); }
function triggerWeatherAlert() { startAlert('Storm caused oil release! Containment required.', 'WEATHER SPILL', '🌀 Tropical storm warning'); }

// =========================================
// SATELLITE SCANNER
// =========================================
let isScanning = false;

function runSatelliteScan() {
    if(isScanning) return;
    isScanning = true;
    document.getElementById('scanLine').classList.add('active');
    document.getElementById('scanLabel').textContent = '🔄 Scanning...';
    document.getElementById('scanStatus').textContent = 'Scanning...';
    document.getElementById('scanStatus').style.color = '#fbbf24';
    document.getElementById('oilResult').textContent = '--';
    document.getElementById('oilResult').style.color = '#64748b';
    document.getElementById('shipsResult').textContent = '--';
    document.getElementById('shipsResult').style.color = '#64748b';
    document.getElementById('formationResult').textContent = '--';
    document.getElementById('formationResult').style.color = '#64748b';
    showToast('🛰️ Scan started', 'info');

    let steps = 0;
    const interval = setInterval(() => {
        steps++;
        if(steps === 1) {
            document.getElementById('scanLabel').textContent = '📡 Analyzing AIS data...';
            document.getElementById('aisShips').textContent = '12';
            document.getElementById('aisSuspicious').textContent = '3';
        } else if(steps === 2) {
            document.getElementById('scanLabel').textContent = '🔬 Triboelectric sensing...';
            document.getElementById('triboStatus').textContent = '● Detecting';
            document.getElementById('triboStatus').style.color = '#fbbf24';
            document.getElementById('oilResult').textContent = 'Detecting...';
            document.getElementById('oilResult').style.color = '#fbbf24';
        } else if(steps === 3) {
            document.getElementById('scanLabel').textContent = '🛸 Deploying UAVs...';
            document.getElementById('uavCount').textContent = '4';
            document.getElementById('uavCoverage').textContent = '92%';
            document.getElementById('shipsResult').textContent = '3 Ships';
            document.getElementById('shipsResult').style.color = '#4a9eff';
        } else if(steps === 4) {
            document.getElementById('scanLabel').textContent = '🛰️ SAR Satellite processing...';
            document.getElementById('formationResult').textContent = 'Analyzing...';
            document.getElementById('formationResult').style.color = '#fbbf24';
        } else if(steps === 5) {
            document.getElementById('scanLabel').textContent = '✅ Scan Complete!';
            document.getElementById('scanStatus').textContent = 'Complete';
            document.getElementById('scanStatus').style.color = '#00d4aa';
            document.getElementById('oilResult').textContent = '✅ Detected ✓';
            document.getElementById('oilResult').style.color = '#00d4aa';
            document.getElementById('shipsResult').textContent = '3 Ships (1 Suspicious)';
            document.getElementById('shipsResult').style.color = '#4a9eff';
            document.getElementById('formationResult').textContent = 'Parallel ⚠️';
            document.getElementById('formationResult').style.color = '#fbbf24';
            document.getElementById('triboStatus').textContent = '● Oil Signature Found';
            document.getElementById('triboStatus').style.color = '#00d4aa';
            document.getElementById('scanLine').classList.remove('active');
            clearInterval(interval);
            isScanning = false;
            showToast('✅ Scan complete!', 'success');
        }
    }, 1200);
}

function resetSatellite() {
    if(isScanning) return;
    document.getElementById('scanLabel').textContent = 'Press "Scan" to start';
    document.getElementById('scanStatus').textContent = 'Ready';
    document.getElementById('scanStatus').style.color = '#64748b';
    document.getElementById('oilResult').textContent = '--';
    document.getElementById('oilResult').style.color = '#64748b';
    document.getElementById('shipsResult').textContent = '--';
    document.getElementById('shipsResult').style.color = '#64748b';
    document.getElementById('formationResult').textContent = '--';
    document.getElementById('formationResult').style.color = '#64748b';
    document.getElementById('triboStatus').textContent = '● Online';
    document.getElementById('triboStatus').style.color = '#00d4aa';
    document.getElementById('aisShips').textContent = '12';
    document.getElementById('aisSuspicious').textContent = '2';
    document.getElementById('uavCount').textContent = '3';
    document.getElementById('uavCoverage').textContent = '85%';
    document.getElementById('scanLine').classList.remove('active');
    showToast('🔄 Reset', 'info');
}

// =========================================
// CHARTS
// =========================================
let spreadChartInstance, pieChartInstance, barChartInstance;

function initCharts() {
    const t = translations[currentLang] || translations.en;
    
    const spreadCtx = document.getElementById('spreadChart').getContext('2d');
    if(spreadChartInstance) spreadChartInstance.destroy();
    spreadChartInstance = new Chart(spreadCtx, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [{
                label: t.spreadTrend || 'Oil Spread (km²)',
                data: [0.5, 0.8, 1.2, 1.8, 2.4, 3.1],
                borderColor: '#4a9eff',
                backgroundColor: 'rgba(74, 158, 255, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { labels: { color: '#e2e8f0', font: { size: 10 } } }
            },
            scales: {
                y: { ticks: { color: '#94a3b8', font: { size: 9 } } },
                x: { ticks: { color: '#94a3b8', font: { size: 9 } } }
            }
        }
    });

    const pieCtx = document.getElementById('pieChart').getContext('2d');
    if(pieChartInstance) pieChartInstance.destroy();
    pieChartInstance = new Chart(pieCtx, {
        type: 'doughnut',
        data: {
            labels: [t.typeNatural || 'Natural', t.typeHuman || 'Human-caused', t.typeTech || 'Technical'],
            datasets: [{
                data: [35, 45, 20],
                backgroundColor: ['#4a9eff', '#ef4444', '#f97316'],
                borderColor: '#05080f',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { color: '#e2e8f0', font: { size: 10 } } }
            }
        }
    });

    const barCtx = document.getElementById('barChart').getContext('2d');
    if(barChartInstance) barChartInstance.destroy();
    barChartInstance = new Chart(barCtx, {
        type: 'bar',
        data: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
            datasets: [
                {
                    label: 'Detected',
                    data: [4, 7, 5, 9],
                    backgroundColor: '#4a9eff',
                    borderRadius: 4
                },
                {
                    label: 'Resolved',
                    data: [3, 5, 4, 7],
                    backgroundColor: '#00d4aa',
                    borderRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { color: '#e2e8f0', font: { size: 10 } } }
            },
            scales: {
                y: { ticks: { color: '#94a3b8', font: { size: 9 } } },
                x: { ticks: { color: '#94a3b8', font: { size: 9 } } }
            }
        }
    });
}

function setTheme(theme) {
    if(theme === 'light') {
        document.body.style.background = '#e8edf5';
        document.body.style.color = '#0a0e1a';
        document.querySelectorAll('.card').forEach(c => c.style.background = 'rgba(255,255,255,0.8)');
        document.querySelectorAll('.sidebar').forEach(s => s.style.background = 'rgba(255,255,255,0.95)');
        showToast('☀️ Light theme', 'info');
    } else {
        document.body.style.background = '#05080f';
        document.body.style.color = '#e8edf5';
        document.querySelectorAll('.card').forEach(c => c.style.background = 'rgba(255,255,255,0.01)');
        document.querySelectorAll('.sidebar').forEach(s => s.style.background = 'rgba(5,8,15,0.95)');
        showToast('🌙 Dark theme', 'info');
    }
}

function exportReport() {
    const data = {
        timestamp: new Date().toISOString(),
        scenario: currentScenario || 'None',
        confidence: document.getElementById('confidenceMeter').textContent,
        ships: document.getElementById('aisShips').textContent,
        weather: {
            temp: document.getElementById('weatherTemp').textContent,
            wind: document.getElementById('weatherWind').textContent,
            humidity: document.getElementById('weatherHumidity').textContent
        }
    };
    const csv = [
        ['Timestamp', 'Scenario', 'Confidence', 'Ships', 'Temperature', 'Wind', 'Humidity'],
        [data.timestamp, data.scenario, data.confidence, data.ships, data.weather.temp, data.weather.wind, data.weather.humidity]
    ].map(row => row.join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'spill-report-' + Date.now() + '.csv';
    a.click();
    URL.revokeObjectURL(url);
    showToast('✅ Report exported!', 'success');
}

function exportReportJSON() {
    const data = {
        timestamp: new Date().toISOString(),
        scenario: currentScenario || 'None',
        confidence: document.getElementById('confidenceMeter').textContent,
        ships: document.getElementById('aisShips').textContent
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'spill-report-' + Date.now() + '.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('✅ JSON Report exported!', 'success');
}

async function fetchWeather() {
    try {
        const response = await fetch('https://api.open-meteo.com/v1/forecast?latitude=13.08&longitude=80.27&current=temperature_2m,relative_humidity_2m,wind_speed_10m&timezone=Asia/Kolkata');
        const data = await response.json();
        const temp = Math.round(data.current.temperature_2m);
        const humidity = Math.round(data.current.relative_humidity_2m);
        const wind = Math.round(data.current.wind_speed_10m);
        document.getElementById('weatherTemp').textContent = temp + '°C';
        document.getElementById('weatherDesc').textContent = 'Chennai, India';
        document.getElementById('weatherWind').textContent = wind;
        document.getElementById('weatherHumidity').textContent = humidity;
        document.getElementById('weatherIcon').textContent = temp > 30 ? '☀️' : temp > 20 ? '🌤️' : '🌥️';
    } catch(e) {
        document.getElementById('weatherTemp').textContent = Math.floor(Math.random() * 15 + 25) + '°C';
        document.getElementById('weatherDesc').textContent = 'Chennai, India';
        document.getElementById('weatherWind').textContent = Math.floor(Math.random() * 20 + 5);
        document.getElementById('weatherHumidity').textContent = Math.floor(Math.random() * 40 + 50);
    }
}
fetchWeather();
setInterval(fetchWeather, 300000);

setInterval(function() {
    document.getElementById('liveOilDensity').textContent = (Math.random() * 100 + 50).toFixed(1);
    document.getElementById('liveSpreadRate').textContent = (Math.random() * 5 + 1).toFixed(2);
    document.getElementById('liveConfidence').textContent = Math.floor(Math.random() * 20 + 75);
    document.getElementById('liveVessels').textContent = Math.floor(Math.random() * 10 + 5);
}, 3000);

let updateCount = 0;
setInterval(() => {
    updateCount++;
    document.getElementById('updateCounter').textContent = '⏳ ' + (updateCount % 60) + 's';
    const confidence = Math.floor(Math.random() * 15 + 85);
    document.getElementById('confidenceMeter').textContent = confidence + '%';
    document.getElementById('confidenceBar').style.width = confidence + '%';
    document.getElementById('systemUptime').textContent = Math.floor(updateCount / 60) + 'm ' + (updateCount % 60) + 's';
}, 3000);

// =========================================
// IMAGE ANALYSIS
// =========================================
const fileInput = document.getElementById('imageInput');
const analyzeBtn = document.getElementById('analyzeBtn');
const analysisResult = document.getElementById('analysisResult');
const fileNameSpan = document.getElementById('fileName');

fileInput.addEventListener('change', function() {
    if (this.files.length > 0) {
        fileNameSpan.textContent = this.files[0].name;
        analysisResult.innerHTML = '⏳ Ready to analyze. Click "Analyze".';
        analysisResult.style.color = '#94a3b8';
    } else {
        fileNameSpan.textContent = 'No file selected';
        analysisResult.innerHTML = '⏳ Waiting for image...';
        analysisResult.style.color = '#94a3b8';
    }
});

analyzeBtn.addEventListener('click', async function() {
    const file = fileInput.files[0];
    if (!file) {
        analysisResult.innerHTML = '⚠️ Please select an image first.';
        analysisResult.style.color = '#f87171';
        return;
    }

    analysisResult.innerHTML = '⏳ Scanning image... Please wait.';
    analysisResult.style.color = '#fbbf24';

    const formData = new FormData();
    formData.append('file', file);
    const backendUrl = document.getElementById('backendUrl') ? document.getElementById('backendUrl').value : 'http://127.0.0.1:8000';

    try {
        const response = await fetch(backendUrl + '/analyze-image', {
            method: 'POST',
            body: formData
        });
        const data = await response.json();
        let message = data.result || 'Analysis completed.';
        if (message.toLowerCase().includes('oil')) {
            analysisResult.innerHTML = '🛢️ ' + message;
            analysisResult.style.color = '#00d4aa';
        } else {
            analysisResult.innerHTML = '🔍 ' + message;
            analysisResult.style.color = '#4a9eff';
        }
    } catch (error) {
        analysisResult.innerHTML = '❌ Cannot reach AI Server. Make sure "python app.py" is running.';
        analysisResult.style.color = '#f87171';
    }
});

// =========================================
// REVIEW QUEUE
// =========================================
function approveReview(btn) {
    const item = btn.closest('.review-item');
    const title = item.querySelector('.title').textContent;
    item.style.opacity = '0.5';
    item.querySelector('.actions').innerHTML = '✅ Approved';
    item.querySelector('.actions').style.color = '#00d4aa';
    showToast('✅ Approved: ' + title, 'success');
    updateReviewCounts();
}

function rejectReview(btn) {
    const item = btn.closest('.review-item');
    const title = item.querySelector('.title').textContent;
    item.style.opacity = '0.5';
    item.querySelector('.actions').innerHTML = '❌ Rejected';
    item.querySelector('.actions').style.color = '#f87171';
    showToast('❌ Rejected: ' + title, 'error');
    updateReviewCounts();
}

function escalateReview(btn) {
    const item = btn.closest('.review-item');
    const title = item.querySelector('.title').textContent;
    item.style.opacity = '0.5';
    item.querySelector('.actions').innerHTML = '⬆️ Escalated';
    item.querySelector('.actions').style.color = '#fbbf24';
    showToast('⬆️ Escalated: ' + title + ' (Sent to Admin)', 'warning');
    updateReviewCounts();
}

function updateReviewCounts() {
    const items = document.querySelectorAll('.review-item');
    let pending = 0, approved = 0, rejected = 0;
    items.forEach(item => {
        const actions = item.querySelector('.actions');
        if (actions.innerHTML.includes('Approved')) approved++;
        else if (actions.innerHTML.includes('Rejected')) rejected++;
        else pending++;
    });
    document.getElementById('pendingCount').textContent = pending;
    document.getElementById('approvedCount').textContent = approved;
    document.getElementById('rejectedCount').textContent = rejected;
    document.getElementById('reviewBadge').style.display = pending > 0 ? 'inline-block' : 'none';
    document.getElementById('reviewBadge').textContent = pending;
}

function retrainModel() {
    showToast('🔄 Model retraining started... This may take a few minutes.', 'info');
    setTimeout(() => {
        showToast('✅ Model retraining complete! New version: v2.4.2', 'success');
        document.getElementById('modelVersion').textContent = 'v2.4.2';
        document.getElementById('lastRetrain').textContent = new Date().toLocaleDateString();
    }, 3000);
}

function clearData() {
    if (confirm('⚠️ This will clear all cached data. Continue?')) {
        localStorage.clear();
        showToast('🧹 Cache cleared!', 'success');
        setTimeout(() => window.location.reload(), 500);
    }
}

window.onload = function() {
    const savedLang = localStorage.getItem('appLang') || 'en';
    setLanguage(savedLang);
    showToast('🚀 Welcome to OCEAN EYE!', 'success');
    showToast('💡 Press Ctrl+? for shortcuts', 'info');
    
    const saved = localStorage.getItem('oilSpillUser');
    if(saved){ try{ const user = JSON.parse(saved); } catch(e){} }
    setTimeout(initMap, 1000);
    if(window.speechSynthesis) window.speechSynthesis.getVoices();
    setTimeout(initCharts, 1500);
    updateReviewCounts();
    console.log('🚀 OCEAN EYE - Platform Loaded');
    console.log('⌨️ Keyboard Shortcuts: Ctrl+1-8');
};
</script><script>
// =========================================
// REAL AIS DATA via AISStream.io (Clean)
// =========================================
const AISSTREAM_KEY = 'fe76b363863aca6b858369e14b92238eb0e48985';

function startAISStream() {
    const socket = new WebSocket('wss://stream.aisstream.io/v0/stream');
    socket.onopen = () => {
        socket.send(JSON.stringify({
            APIKey: AISSTREAM_KEY,
            BoundingBoxes: [[[5, 75], [25, 95]]]
        }));
    };
    socket.onmessage = (event) => {
        try {
            const data = JSON.parse(event.data);
            if (data.MessageType === "PositionReport") {
                const ship = data.Message;
                const lat = ship.Latitude;
                const lon = ship.Longitude;
                if (lat && lon && typeof mapInstance !== 'undefined' && mapInstance) {
                    L.marker([lat, lon], {
                        icon: L.divIcon({ html: '🚢', iconSize: [14, 14] })
                    }).addTo(mapInstance).bindPopup(`🛳️ ${ship.ShipName || 'Unknown'}<br>MMSI: ${ship.MMSI || 'N/A'}<br>Speed: ${ship.SOG || 'N/A'} kn`);
                }
            }
        } catch(e) {}
    };
    socket.onerror = (error) => console.log('AISStream error:', error);
}

// Start AIS stream after map loads
setTimeout(startAISStream, 3000);
</script>
<script>
(function() {
    let satelliteMapInstance = null;
    let liveSatelliteEnabled = false;
    function toggleLiveSatellite() {
        liveSatelliteEnabled = !liveSatelliteEnabled;
        const simDiv = document.getElementById('satSimulation');
        const mapContainer = document.getElementById('satelliteMapContainer');
        const scanLabel = document.getElementById('scanLabel');
        if (!simDiv || !mapContainer) { showToast("Satellite view unavailable", "error"); return; }
        if (liveSatelliteEnabled) {
            simDiv.style.display = 'none';
            mapContainer.style.display = 'block';
            scanLabel.textContent = '🛰️ Live Satellite View (NASA GIBS)';
            if (!satelliteMapInstance) initSatelliteMap();
            else satelliteMapInstance.invalidateSize();
            showToast('Live satellite imagery enabled', 'success');
        } else {
            simDiv.style.display = 'flex';
            mapContainer.style.display = 'none';
            scanLabel.textContent = 'Press "Scan" to start';
            showToast('Back to simulation mode', 'info');
        }
    }
    function initSatelliteMap() {
        const container = document.getElementById('satelliteMapContainer');
        if (!container) return;
        satelliteMapInstance = L.map(container, {
            center: [22.41, 88.46],
            zoom: 10,
            zoomControl: false,
            attributionControl: false
        });
        L.tileLayer('https://gibs-{s}.earthdata.nasa.gov/wmts/epsg3857/best/VIIRS_SNPP_CorrectedReflectance_TrueColor/default/current/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpg', {
            subdomains: ['a','b','c','d'],
            maxZoom: 12,
            minZoom: 5,
            attribution: 'NASA GIBS'
        }).addTo(satelliteMapInstance);
        L.marker([22.41, 88.46], {
            icon: L.divIcon({ html: '🛢️', iconSize: [20,20], className: 'satellite-marker' })
        }).addTo(satelliteMapInstance).bindPopup('Oil Spill Area');
        L.circle([22.41, 88.46], {
            color: '#ef4444',
            fillColor: '#ef4444',
            fillOpacity: 0.1,
            radius: 5000
        }).addTo(satelliteMapInstance);
        setTimeout(() => { if (satelliteMapInstance) satelliteMapInstance.invalidateSize(); }, 300);
    }
    window.toggleLiveSatellite = toggleLiveSatellite;
    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('liveSatBtn');
        if (btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                toggleLiveSatellite();
            });
        }
    });
})();
</script>
<script src="map-enhancements.js"></script>
</body>
